# OpenAI-compatible translation service. You can also set these in the web UI.
TRANSLATION_API_KEY=
TRANSLATION_BASE_URL=https://api.deepseek.com/v1
TRANSLATION_MODEL=deepseek-chat
TRANSLATION_PROTOCOL=openai
TRANSLATION_USE_SYSTEM_PROXY=false
TRANSLATION_BATCH_SIZE=3
TRANSLATION_REQUEST_CHAR_LIMIT=6000
TRANSLATION_MAX_RETRIES=5

# Local server. Keep 127.0.0.1 unless you intentionally want LAN access.
APP_HOST=127.0.0.1
APP_PORT=6670

# Default folder for the translated-DOCX "save as" dialog (set to D:\ by default).
APP_DOWNLOAD_DIR=D:\
